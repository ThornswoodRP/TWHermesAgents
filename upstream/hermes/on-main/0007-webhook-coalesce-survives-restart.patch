 from __future__ import annotations
 
 import asyncio
+import json
 import logging
 import re
 import time
 from dataclasses import dataclass
+from pathlib import Path
 from typing import Any, Callable, Dict, Optional
 
 logger = logging.getLogger(__name__)
@@ -63,13 +72,75 @@ class PendingEvent:
                 f"and were coalesced — this is the most recent one; earlier events are superseded.)")
 
 
+# What a spooled group keeps of its dispatch kwargs: plain names only. ``route_config`` is never
+# written (it can hold the route's HMAC secret); ``restore`` reads it back from the live routes.
+_SPOOLED_KWARGS = ("route_name", "event_type", "profile")
+
+
+class CoalesceSpool:
+    """Pending coalesce groups on disk, ``{group_key: record}``, written atomically (0600) on every
+    change. A missing file is an empty spool; an unreadable one is set aside, never overwritten."""
+
+    def __init__(self, path: Path | str):
+        self.path = Path(path)
+
+    def load(self) -> dict[str, dict]:
+        try:
+            raw = self.path.read_text(encoding="utf-8")
+        except FileNotFoundError:
+            return {}
+        except OSError as exc:
+            logger.error("[webhook] coalesce spool %s unreadable: %s", self.path, exc)
+            return {}
+        try:
+            data = json.loads(raw)
+            if not isinstance(data, dict) or not all(isinstance(v, dict) for v in data.values()):
+                raise ValueError("not an object of groups")
+        except ValueError as exc:
+            aside = self.path.with_name(f"{self.path.name}.bad-{int(time.time())}")
+            try:
+                self.path.replace(aside)
+            except OSError:
+                aside = self.path
+            logger.error("[webhook] coalesce spool %s is not valid (%s); kept as %s, nothing restored",
+                         self.path, exc, aside)
+            return {}
+        return data
+
+    def _write(self, data: dict[str, dict]) -> None:
+        from utils import atomic_json_write
+        try:
+            if data:
+                self.path.parent.mkdir(parents=True, exist_ok=True)
+                atomic_json_write(self.path, data, indent=None, mode=0o600)
+            else:
+                self.path.unlink(missing_ok=True)
+        except (OSError, TypeError, ValueError) as exc:
+            logger.error("[webhook] coalesce spool %s not written: %s", self.path, exc)
+
+    def put(self, group_key: str, record: dict) -> None:
+        data = self.load()
+        data[group_key] = record
+        self._write(data)
+
+    def drop(self, group_key: str, delivery_id: str) -> None:
+        """Forget a group's record, only while it is still this delivery's: a newer event for the
+        same group, buffered while this one was being admitted, keeps its own record."""
+        data = self.load()
+        if (data.get(group_key) or {}).get("delivery_id") == delivery_id:
+            del data[group_key]
+            self._write(data)
+
+
 class WebhookCoalescer:
     """Debounce-and-supersede buffer. ``dispatch(payload, prompt, delivery_id, **kwargs)`` is the adapter's
     agent-run spawner. Only ever driven from the aiohttp event loop → no locking."""
 
-    def __init__(self, dispatch: Callable[..., Any], render: Callable[[str, dict, str, str], str]):
+    def __init__(self, dispatch: Callable[..., Any], render: Callable[[str, dict, str, str], str],
+                 spool: Optional[CoalesceSpool] = None):
         self._dispatch = dispatch
         self._render = render
+        self._spool = spool
         self._pending: dict[str, PendingEvent] = {}
         self._timers: dict[str, asyncio.Task] = {}
 
@@ -103,19 +174,57 @@ class WebhookCoalescer:
         count = existing.count + 1 if existing else 1
         dispatch_kwargs = {**dispatch_kwargs, "route_name": route_name, "event_type": event_type}
         superseded = (*existing.superseded, existing.delivery_id) if existing else ()
-        self._pending[group_key] = PendingEvent(payload=payload, prompt=prompt, delivery_id=delivery_id,
-                                                first_at=first_at, count=count, dispatch_kwargs=dispatch_kwargs,
-                                                superseded=superseded)
+        entry = PendingEvent(payload=payload, prompt=prompt, delivery_id=delivery_id, first_at=first_at,
+                             count=count, dispatch_kwargs=dispatch_kwargs, superseded=superseded)
+        self._pending[group_key] = entry
+        if self._spool is not None:
+            self._spool.put(group_key, _record(entry))
         if existing is not None:
             logger.info("[webhook] coalesced delivery %s superseded by %s (group=%s, %d events)",
                         existing.delivery_id, delivery_id, group_key, count)
+        self._arm(group_key, min(window, max(0.0, first_at + max_wait - now)))
+        return True
+
+    def _arm(self, group_key: str, delay: float) -> None:
         old = self._timers.pop(group_key, None)
         if old is not None and not old.done():
             old.cancel()
         # Quiet window from now, capped at max_wait past the group's FIRST event.
-        delay = min(window, max(0.0, first_at + max_wait - now))
         self._timers[group_key] = asyncio.create_task(self._timer(group_key, delay))
-        return True
+
+    def settled(self, group_key: str, delivery_id: str) -> None:
+        """The group's admission is over (committed, or refused for good): its spooled copy goes."""
+        if self._spool is not None:
+            self._spool.drop(group_key, delivery_id)
+
+    def restore(self, route_config_for: Callable[[str], Optional[dict]], now: float) -> int:
+        """Buffer again every group the spool still holds (a previous run acknowledged it and never
+        admitted it), each with a fresh quiet window. A group whose route is gone or no longer
+        coalesces is dropped and named. Returns how many were buffered."""
+        if self._spool is None:
+            return 0
+        restored = 0
+        for group_key, rec in self._spool.load().items():
+            if group_key in self._pending:
+                continue
+            kwargs = rec.get("dispatch_kwargs") or {}
+            route_config = route_config_for(kwargs.get("route_name"))
+            coalesce = (route_config or {}).get("coalesce")
+            if not isinstance(coalesce, dict) or not isinstance(rec.get("delivery_id"), str):
+                logger.warning("[webhook] coalesced delivery %s (group=%s) not restored: route %r no longer "
+                               "coalesces", rec.get("delivery_id"), group_key, kwargs.get("route_name"))
+                self._spool.drop(group_key, rec.get("delivery_id"))
+                continue
+            self._pending[group_key] = PendingEvent(
+                payload=rec.get("payload"), prompt=str(rec.get("prompt") or ""), delivery_id=rec["delivery_id"],
+                first_at=now, count=int(rec.get("count") or 1),
+                dispatch_kwargs={**{k: kwargs.get(k) for k in _SPOOLED_KWARGS}, "route_config": route_config},
+                superseded=tuple(rec.get("superseded") or ()))
+            self._arm(group_key, float(coalesce.get("window_seconds", DEFAULT_WINDOW_SECONDS)))
+            logger.info("[webhook] coalesced delivery %s restored from the spool (group=%s)",
+                        rec["delivery_id"], group_key)
+            restored += 1
+        return restored
 
     async def _timer(self, group_key: str, delay: float) -> None:
         try:
@@ -132,11 +241,12 @@ class WebhookCoalescer:
         logger.info("[webhook] coalesce settled group=%s events=%d delivery=%s", group_key, entry.count,
                     entry.delivery_id)
         return self._dispatch(entry.payload, entry.prompt_with_note(), entry.delivery_id, time.time(),
-                              **entry.dispatch_kwargs, superseded=entry.superseded)
+                              **entry.dispatch_kwargs, superseded=entry.superseded, coalesce_group=group_key)
 
     async def flush(self) -> None:
         """Dispatch every pending group now and wait until each run is handed to the runner, so an adapter
-        disconnect/reconnect drops nothing. A hard process kill still loses the current window's buffer."""
+        disconnect/reconnect drops nothing. A group whose admission cannot run (the gateway is stopping)
+        stays in the spool for the next start, as it does after a hard kill."""
         for task in self._timers.values():
             if not task.done():
                 task.cancel()
@@ -151,3 +261,9 @@ class WebhookCoalescer:
         awaitables = [t for t in handed_off if isinstance(t, asyncio.Future)]
         if awaitables:
             await asyncio.gather(*awaitables, return_exceptions=True)
+
+
+def _record(entry: PendingEvent) -> dict:
+    return {"payload": entry.payload, "prompt": entry.prompt, "delivery_id": entry.delivery_id,
+            "count": entry.count, "superseded": list(entry.superseded),
+            "dispatch_kwargs": {k: entry.dispatch_kwargs.get(k) for k in _SPOOLED_KWARGS}}
