+# ── The spool: an acknowledged coalesced delivery survives a restart ─────────────────────────
+
+
+def _spool(adapter):
+    path = adapter._coalescer._spool.path
+    return json.loads(path.read_text()) if path.exists() else {}
+
+
+@pytest.mark.asyncio
+async def test_a_drain_keeps_the_group_for_the_next_run_which_admits_it(monkeypatch):
+    """The drain withdraws ingress before the adapter's disconnect flush. The acknowledged group is
+    not tried against a withdrawn ingress (which raised ``RuntimeStoreError('not_found')`` and lost
+    it): it stays spooled, and the next run buffers it again and admits it."""
+    route = {**_coalesce_route(key="pull_request.number", window_seconds=60), "secret": "s3cret-hmac"}
+    adapter = _make_adapter(routes={"pr": route})
+    admitted = _capture_admissions(adapter, monkeypatch)
+    for i in range(2):
+        await adapter._handle_webhook(_mock_request(_payload(9), delivery_id=f"r{i}"))
+    adapter.set_message_handler(None)  # drain_gateway_runtime
+    await adapter.disconnect()
+    assert admitted == []
+    spooled = _spool(adapter)
+    assert [r["delivery_id"] for r in spooled.values()] == ["r1"]
+    assert "s3cret-hmac" not in adapter._coalescer._spool.path.read_text()  # route_config never written
+    if os.name == "posix":
+        assert stat.S_IMODE(adapter._coalescer._spool.path.stat().st_mode) == 0o600
+
+    route["coalesce"]["window_seconds"] = 0.05
+    nxt = _make_adapter(routes={"pr": route})
+    nxt_admitted = _capture_admissions(nxt, monkeypatch)
+    nxt._runner = object()  # the listener is up
+    nxt.set_message_handler(nxt._message_handler)
+    await asyncio.sleep(0.15)
+    assert [e.message_id for e in nxt_admitted] == ["r1"]
+    assert "PR 9" in nxt_admitted[0].text and "2 webhook events" in nxt_admitted[0].text
+    assert _spool(nxt) == {}
+
+
+@pytest.mark.asyncio
+async def test_an_admitted_group_leaves_the_spool_and_a_refused_one_is_given_back(monkeypatch):
+    adapter = _make_adapter(routes={"pr": _coalesce_route(key="pull_request.number", window_seconds=0.05)})
+    admitted = _capture_admissions(adapter, monkeypatch)
+    await adapter._handle_webhook(_mock_request(_payload(1), delivery_id="ok"))
+    assert len(_spool(adapter)) == 1
+    await asyncio.sleep(0.15)
+    assert [e.message_id for e in admitted] == ["ok"] and _spool(adapter) == {}
+
+    async def _refuse(_adapter, event):
+        raise RuntimeError("profile_mismatch")
+    monkeypatch.setattr(webhook_ingress, "admit_producer", _refuse)
+    await adapter._handle_webhook(_mock_request(_payload(2), delivery_id="no"))
+    await asyncio.sleep(0.15)
+    # Refused by a serving gateway: not kept, and its id is given back so the provider's resend runs.
+    assert _spool(adapter) == {}
+    resend = await adapter._handle_webhook(_mock_request(_payload(2), delivery_id="no"))
+    assert json.loads(resend.text)["status"] == "coalesced"
+
+
