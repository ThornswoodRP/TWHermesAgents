 tests/tui_gateway/test_display_watch.py | 64 +++++++++++++++++++++++++
 tui_gateway/methods_display_watch.py    | 25 ++++++----
 2 files changed, 79 insertions(+), 10 deletions(-)

diff --git a/tests/tui_gateway/test_display_watch.py b/tests/tui_gateway/test_display_watch.py
index fe64364ba8..6e7008cc14 100644
--- a/tests/tui_gateway/test_display_watch.py
+++ b/tests/tui_gateway/test_display_watch.py
@@ -197,3 +197,67 @@ def test_screen_start_and_stop_reach_the_models_turn_notes(tmp_path, monkeypatch
         if launcher.poll() is None:
             launcher.kill()
             launcher.wait(5)
+
+
+def _secondary_with_cwd(tmp_path, name: str) -> tuple[Path, Path]:
+    home = tmp_path / "profiles" / name
+    (home / "bot-desktop").mkdir(parents=True)
+    work = tmp_path / f"{name}-work"
+    work.mkdir()
+    (home / "config.yaml").write_text(f"terminal:\n  backend: local\n  cwd: {work}\n", encoding="utf-8")
+    return home, work
+
+
+def test_a_watched_profile_home_is_polled_under_its_own_terminal_policy(tmp_path, monkeypatch):
+    """A screen that comes up in a served profile's home is re-read by every serve process watching that
+    home. Under HERMES_HOME alone the status read ran on the LAUNCH profile's terminal policy, so the
+    re-attach of a sandbox-hosted screen built a container keyed and mounted as the watched profile but
+    rooted at the launch profile's terminal.cwd, one per watching process. The poll binds the watched
+    home's full scope, as @_profile_scoped does for a display.* call."""
+    from hermes_constants import get_hermes_home
+    from tools.terminal_scope import terminal_env
+    from tui_gateway import server
+
+    launch = tmp_path / "launch"
+    (launch / "bot-desktop").mkdir(parents=True)
+    monkeypatch.setenv("TERMINAL_CWD", str(tmp_path / "launch-work"))
+    other, other_work = _secondary_with_cwd(tmp_path, "bramble")
+    _watching(server, launch, monkeypatch)
+    monkeypatch.setattr(server, "_served_profile_homes", {other})
+    seen: list = []
+
+    def snapshot() -> dict:
+        seen.append((Path(get_hermes_home()).resolve(), terminal_env("TERMINAL_CWD")))
+        return {"running": True}
+
+    monkeypatch.setattr(server, "_display_snapshot", snapshot)
+    monkeypatch.setattr(server, "_notify_agents_of_screen_change", lambda key, payload: None)
+    server._poll_runtime_files()  # seeds both homes
+    (other / "bot-desktop" / "env").write_text("DISPLAY=:20\n", encoding="utf-8")
+    server._poll_runtime_files()
+
+    assert seen == [(other.resolve(), str(other_work))], seen
+
+
+def test_the_idle_check_runs_under_each_watched_home_s_own_terminal_policy(tmp_path, monkeypatch):
+    """The idle stop re-attaches a sandbox-hosted screen the same way, so it binds the same scope."""
+    from hermes_constants import get_hermes_home
+    from tools.bot_desktop import runtime as bd_runtime
+    from tools.terminal_scope import terminal_env
+    from tui_gateway import server
+
+    launch = tmp_path / "launch"
+    launch.mkdir()
+    monkeypatch.setenv("TERMINAL_CWD", str(tmp_path / "launch-work"))
+    other, other_work = _secondary_with_cwd(tmp_path, "echo")
+    monkeypatch.setattr(server, "_hermes_home", str(launch))
+    monkeypatch.setattr(server, "_served_profile_homes", {other})
+    monkeypatch.setattr(server, "_last_idle_check", 0.0)
+    seen: list = []
+    monkeypatch.setattr(bd_runtime, "stop_if_idle",
+                        lambda: seen.append((Path(get_hermes_home()).resolve(), terminal_env("TERMINAL_CWD"))))
+
+    server._poll_idle_screens()
+
+    assert (other.resolve(), str(other_work)) in seen, seen
+    assert all(cwd != str(other_work) for home, cwd in seen if home != other.resolve()), seen
diff --git a/tui_gateway/methods_display_watch.py b/tui_gateway/methods_display_watch.py
index 4a17a39d79..4ccd246bb3 100644
--- a/tui_gateway/methods_display_watch.py
+++ b/tui_gateway/methods_display_watch.py
@@ -39,6 +39,18 @@ def _watched_lease_homes() -> list[Path]:
     return [Path(_hermes_home), *_served_profile_homes]
 
 
+def _watched_home_scope(home: Path):
+    """Bind ``home``'s full runtime scope (home + secrets + terminal) for one poll body, the same
+    composition ``@_profile_scoped`` binds for a ``display.*`` call. HERMES_HOME alone is half-bound:
+    the status read re-attaches a sandbox-hosted screen (``runtime._owned_sandbox_env``), and under
+    the LAUNCH profile's terminal policy that re-attach built a new container keyed and mounted as
+    the watched profile but rooted at the launch profile's ``terminal.cwd``, once in every serve
+    process watching that home. The launch home maps to None so it keeps its frozen launch env. No
+    external-source hydration: these bodies read runtime files and status, never call a provider."""
+    launch = Path(home).resolve() == Path(_hermes_home).resolve()
+    return _session_profile_runtime_scope({"profile_home": None if launch else str(home)}, hydrate_secrets=False)
+
+
 def _mtime(path: Path):
     try:
         return path.stat().st_mtime_ns
@@ -82,13 +94,12 @@ def _poll_runtime_files() -> None:
     """Broadcast ``display.status`` when a home's screen started/stopped outside this process — a
     file move (start/stop by the CLI or gateway) or the launcher dying without touching its files
     (Xvnc crash: env and launcher.pid stay put, only the pid stops being live)."""
-    from hermes_constants import hermes_home_key, reset_hermes_home_override, set_hermes_home_override
+    from hermes_constants import hermes_home_key
     from tools.bot_desktop import runtime as _bd_runtime
     for home in _watched_lease_homes():
         key = hermes_home_key(home)
         sd = home / "bot-desktop"
-        token = set_hermes_home_override(home)
-        try:
+        with _watched_home_scope(home):
             mark = (_mtime(sd / "env"), _mtime(sd / "launcher.pid"), _bd_runtime._launcher_pid() is not None)
             first = key not in _runtime_marks
             if _runtime_marks.get(key) == mark:
@@ -97,8 +108,6 @@ def _poll_runtime_files() -> None:
             if first:  # seeding: display.status carries the current state
                 continue
             payload = _display_snapshot()
-        finally:
-            reset_hermes_home_override(token)
         _broadcast_global_event("display.status", payload)
         _notify_agents_of_screen_change(key, payload)
 
@@ -114,14 +123,10 @@ def _poll_idle_screens() -> None:
     if time.monotonic() - _last_idle_check < _IDLE_CHECK_S:
         return
     _last_idle_check = time.monotonic()
-    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
     from tools.bot_desktop import runtime as _bd_runtime
     for home in _watched_lease_homes():
-        token = set_hermes_home_override(home)
-        try:
+        with _watched_home_scope(home):
             _bd_runtime.stop_if_idle()
-        finally:
-            reset_hermes_home_override(token)
 
 
 def _poll_lease_files() -> None:
