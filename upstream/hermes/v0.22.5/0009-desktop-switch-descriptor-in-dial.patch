+export async function openGatewayAgent(connectionId: string, profile: string): Promise<HermesConnection | null> {
   const connection = connectionId.trim()
 
   if (!connection) {
-    return
+    return null
   }
 
-  await openGatewayForAgent(connection, normalizeProfileKey(profile), {
-    activationLease: true,
-    spawnPriority: 'foreground'
-  })
+  const target = normalizeProfileKey(profile)
+  const getConnectionFor = window.hermesDesktop?.getConnectionFor
+
+  const [descriptor] = await Promise.all([
+    getConnectionFor ? getConnectionFor({ connectionId: connection, profile: target }) : Promise.resolve(null),
+    openGatewayForAgent(connection, target, {
+      activationLease: true,
+      spawnPriority: 'foreground'
+    })
+  ])
+
+  return descriptor ?? null
 }
 
