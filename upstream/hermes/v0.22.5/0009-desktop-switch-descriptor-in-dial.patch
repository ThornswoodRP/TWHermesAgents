diff --git a/apps/desktop/src/store/profile-agent-dial-descriptor.test.ts b/apps/desktop/src/store/profile-agent-dial-descriptor.test.ts
new file mode 100644
index 0000000000..2a7d10ea58
--- /dev/null
+++ b/apps/desktop/src/store/profile-agent-dial-descriptor.test.ts
@@ -0,0 +1,125 @@
+import { atom } from 'nanostores'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { HermesConnection } from '@/global'
+
+import { deferred } from '../test/deferred'
+
+// Phase one of the two-phase source switch resolves the target's descriptor
+// (openGatewayAgent), and the commit (ensureGatewayAgent with that descriptor)
+// makes no lookup of its own. The lookup can wait on a whole remote boot, which
+// must run on the dial's budget, before anything is severed — not inside the
+// commit's local 20 s window.
+
+const ensureGatewayForAgent = vi.fn(async (_connectionId: null | string, _profile: string) => true)
+const ensureGatewayForProfile = vi.fn(async (_profile: string) => undefined)
+const openGatewayForAgent = vi.fn(async (_connectionId: null | string, _profile: string, _options?: unknown) => undefined)
+const openGatewayForProfile = vi.fn(async (_profile: string) => undefined)
+
+vi.mock('@/store/gateway', () => ({
+  $gateway: atom<unknown>({ id: 'live-socket' }),
+  activeGatewayProfileKey: () => ensureGatewayForAgent.mock.lastCall?.[1] ?? 'default',
+  ensureGatewayForAgent,
+  ensureGatewayForProfile,
+  openGatewayForAgent,
+  openGatewayForProfile
+}))
+vi.mock('@/hermes', () => ({
+  getProfiles: vi.fn(async () => ({ profiles: [] })),
+  setApiRequestProfile: vi.fn()
+}))
+vi.mock('@/lib/query-client', () => ({ invalidateProfileScopedQueries: vi.fn() }))
+vi.mock('@/store/starmap', () => ({ reloadOpenStarmapGraph: vi.fn(), resetStarmapGraph: vi.fn() }))
+
+const { $activeGatewayProfile, ensureGatewayAgent, openGatewayAgent } = await import('./profile')
+const { $connection } = await import('./session')
+
+const agentConn = (over: Partial<HermesConnection> = {}): HermesConnection =>
+  ({ baseUrl: 'https://homelab.invalid', connectionId: 'homelab', mode: 'remote', profile: 'research', ...over }) as HermesConnection
+
+const localConn = (): HermesConnection => ({ baseUrl: '', mode: 'local', profile: 'default' }) as HermesConnection
+
+const getConnectionFor =
+  vi.fn<(payload: { connectionId?: null | string; profile?: null | string }) => Promise<HermesConnection>>()
+
+beforeEach(() => {
+  getConnectionFor.mockReset()
+  ensureGatewayForAgent.mockClear()
+  openGatewayForAgent.mockClear()
+  $activeGatewayProfile.set('default')
+  $connection.set(localConn())
+  vi.stubGlobal('window', { hermesDesktop: { getConnection: vi.fn(), getConnectionFor }, localStorage: window.localStorage })
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  $connection.set(null)
+})
+
+describe('openGatewayAgent resolves the descriptor as part of the dial', () => {
+  it('settles only once the descriptor arrives, returns it, and touches nothing', async () => {
+    const lookup = deferred<HermesConnection>()
+    getConnectionFor.mockImplementationOnce(() => lookup.promise)
+
+    let settled = false
+
+    const dial = openGatewayAgent('homelab', 'research').then(result => {
+      settled = true
+
+      return result
+    })
+
+    await Promise.resolve()
+    await Promise.resolve()
+
+    expect(openGatewayForAgent).toHaveBeenCalledWith('homelab', 'research', {
+      activationLease: true,
+      spawnPriority: 'foreground'
+    })
+    expect(getConnectionFor).toHaveBeenCalledWith({ connectionId: 'homelab', profile: 'research' })
+    expect(settled).toBe(false)
+
+    lookup.resolve(agentConn())
+
+    expect(await dial).toEqual(agentConn())
+    expect($connection.get()?.mode).toBe('local')
+    expect($activeGatewayProfile.get()).toBe('default')
+  })
+
+  it('a failed lookup fails the dial, before the commit can sever anything', async () => {
+    getConnectionFor.mockRejectedValueOnce(new Error('source unreachable'))
+
+    await expect(openGatewayAgent('homelab', 'research')).rejects.toThrow('source unreachable')
+    expect($connection.get()?.mode).toBe('local')
+    expect($activeGatewayProfile.get()).toBe('default')
+  })
+
+  it('resolves null when the bridge has no registry lookup', async () => {
+    vi.stubGlobal('window', { hermesDesktop: { getConnection: vi.fn() }, localStorage: window.localStorage })
+
+    expect(await openGatewayAgent('homelab', 'research')).toBeNull()
+  })
+})
+
+describe('ensureGatewayAgent with the descriptor the dial resolved', () => {
+  it('publishes it without a lookup of its own, even while main would still be booting the target', async () => {
+    // A lookup now would wait on the remote boot; the commit must not ask.
+    getConnectionFor.mockImplementation(() => new Promise<HermesConnection>(() => undefined))
+
+    await ensureGatewayAgent('homelab', 'research', { descriptor: agentConn() })
+
+    expect(getConnectionFor).not.toHaveBeenCalled()
+    expect(ensureGatewayForAgent).toHaveBeenCalledWith('homelab', 'research')
+    expect($connection.get()).toEqual(agentConn())
+    expect($activeGatewayProfile.get()).toBe('research')
+  })
+
+  it('without one, still looks the descriptor up itself (the SDK and session doors)', async () => {
+    getConnectionFor.mockResolvedValueOnce(agentConn())
+
+    await ensureGatewayAgent('homelab', 'research')
+
+    expect(getConnectionFor).toHaveBeenCalledWith({ connectionId: 'homelab', profile: 'research' })
+    expect($connection.get()).toEqual(agentConn())
+  })
+})
