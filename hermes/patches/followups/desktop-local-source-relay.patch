 .../hooks/use-session-actions/utils.ts        | 42 ++-----------------
 2 files changed, 40 insertions(+), 39 deletions(-)
 create mode 100644 apps/desktop/src/app/session/hooks/use-session-actions/known-session-owner.ts

diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/known-session-owner.ts b/apps/desktop/src/app/session/hooks/use-session-actions/known-session-owner.ts
