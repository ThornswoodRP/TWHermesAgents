@@ -1940,6 +1940,59 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
             logger.debug("Codex quota-restored probe failed", exc_info=True)
             return False
 
+    def _anthropic_quota_restored_upstream(self, entry: PooledCredential, model: Optional[str]) -> bool:
+        """Live-check whether a Claude subscription limit that benched this entry for ``model``
+        reopened early.
+
+        An Anthropic 429 benches the OAuth entry for the refused model (``_cool_down_model``) until
+        the reset the response named, days out for a subscription's weekly window. The window
+        reopens sooner when the account is given a reset or changes plan, and nothing but Anthropic's
+        usage endpoint says so. Only a model bench longer than the probe interval is asked about: a
+        per-minute limit lifts by itself sooner than the probe could. The stored token is refreshed
+        first when it is due (a refresh keeps the model bench), since a benched entry is skipped by
+        the refresh chain and an expired token gets no answer. Fails closed, as the Codex check does.
+        """
+        from agent.anthropic_quota_probe import (
+            ANTHROPIC_QUOTA_PROBE_MIN_INTERVAL_SECONDS, probe_anthropic_quota_restored,
+        )
+
+        if self.provider != "anthropic" or entry.auth_type != AUTH_TYPE_OAUTH or not model:
+            return False
+        until = model_cooldown_until(entry, model)
+        if until is None or until - time.time() <= ANTHROPIC_QUOTA_PROBE_MIN_INTERVAL_SECONDS:
+            return False
+        try:
+            if self._entry_needs_refresh(entry):
+                refreshed = self._refresh_entry(entry, force=False)
+                if refreshed is None:
+                    return False
+                entry = refreshed
+            return bool(probe_anthropic_quota_restored(entry.access_token, model=model))
+        except OSError:  # the auth store's lock or file: no fresh token, so no answer, and the bench stays
+            logger.debug("Anthropic quota-restored probe failed", exc_info=True)
+            return False
+
+    def _lift_model_cooldown(
+        self, entry: PooledCredential, model: Optional[str],
+    ) -> tuple[PooledCredential, list[str]]:
+        """Clear ``model``'s cooldown on ``entry`` and on every entry sharing its key, the rows
+        ``_cool_down_model`` benched together. A verified early reopen is a reset, so each row is
+        marked cleared (``status_cleared_at``) and the caller persists those ids as cleared: the
+        disk's older cooldown is then not merged back over it. Caller holds the lock and persists.
+        Returns the live entry and the ids it lifted."""
+        key = entry.runtime_api_key
+        live, ids = entry, []
+        for scoped in list(self._entries):
+            if scoped.id != entry.id and not (key and scoped.runtime_api_key == key):
+                continue
+            cooldowns = {m: until for m, until in (scoped.model_cooldowns or {}).items() if m != model}
+            updated = self._adopt(scoped, persist=False, model_cooldowns=cooldowns or None,
+                                  status_cleared_at=time.time())
+            ids.append(updated.id)
+            if scoped.id == entry.id:
+                live = updated
+        return live, ids
+
     def _entry_needs_refresh(self, entry: PooledCredential) -> bool:
         if entry.auth_type != AUTH_TYPE_OAUTH:
             return False
@@ -2045,6 +2098,7 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
         available: list[PooledCredential] = []
         pending_refresh: list[PooledCredential] = []
