             # Borrowed credentials persist as metadata-only references and are
             # hydrated from their live source on load; never lease an
@@ -2075,7 +2129,14 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
                         cleared_any = True
                 continue
             if model_cooldown_until(entry, model) is not None:
-                continue
+                # A Claude subscription window can reopen early too: a live probe lifts the
