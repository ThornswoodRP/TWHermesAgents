diff --git a/agent/anthropic_quota_probe.py b/agent/anthropic_quota_probe.py
new file mode 100644
index 00000000..0474c7bc
--- /dev/null
+++ b/agent/anthropic_quota_probe.py
@@ -0,0 +1,96 @@
+"""Whether a Claude subscription limit that benched a login has reopened before its declared reset.
+
+A Claude subscription (Pro or Max) 429 benches the OAuth login for the refused model until the reset
+the response named (its ``Retry-After``), which is days out for the weekly window. The window can
+reopen sooner: the account is given a reset, or the plan changes. Only Anthropic's OAuth usage
+endpoint says so, the one ``/usage`` reads (``agent/account_usage._fetch_anthropic_account_usage``).
+Without asking it, a session pinned to its fallback stays there until the old reset time.
+
+The same rules as the Codex probe (``hermes_cli/auth_codex._probe_codex_quota_restored``): throttled
+per token and model, so the hot selection path can call it freely; it fails closed, so any doubt (no
+answer, a refusal, no window it can read) keeps the cooldown.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import threading
+import time
+from typing import Optional
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+ANTHROPIC_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
+ANTHROPIC_QUOTA_PROBE_MIN_INTERVAL_SECONDS = 300  # 5 minutes, as the Codex probe
+
+# The windows that refuse every model on the login, and the ones that refuse one model family only.
+ACCOUNT_WINDOWS = ("five_hour", "seven_day")
+FAMILY_WINDOWS = (("opus", "seven_day_opus"), ("sonnet", "seven_day_sonnet"))
+
+_cache: dict[str, tuple[float, Optional[bool]]] = {}
+_lock = threading.Lock()
+
+
+def _windows_for(model: Optional[str]) -> tuple[str, ...]:
+    name = (model or "").lower()
+    return ACCOUNT_WINDOWS + tuple(key for family, key in FAMILY_WINDOWS if family in name)
+
+
+def _used_percent(window) -> Optional[float]:
+    """A window's utilization as a percent, read the way ``/usage`` reads it
+    (``account_usage._usage_windows`` with ``fraction=True``)."""
+    used = window.get("utilization") if isinstance(window, dict) else None
+    if isinstance(used, bool) or not isinstance(used, (int, float)):
+        return None
+    used = float(used)
+    return used * 100 if used <= 1 else used
+
+
+def quota_restored(payload: dict, model: Optional[str]) -> Optional[bool]:
+    """True when every window that refuses ``model`` is under 100%; False when one is full; None when the
+    payload holds none of them."""
+    seen = [p for p in (_used_percent(payload.get(key)) for key in _windows_for(model)) if p is not None]
+    if not seen:
+        return None
+    return max(seen) < 100.0
+
+
+def probe_anthropic_quota_restored(
+    access_token: Optional[str], *, model: Optional[str] = None,
+    min_interval_seconds: float = ANTHROPIC_QUOTA_PROBE_MIN_INTERVAL_SECONDS,
+) -> Optional[bool]:
+    """Ask the usage endpoint whether this login can serve ``model`` again. None: no answer."""
+    from agent.anthropic_credentials import _is_oauth_token
+
+    token = (access_token or "").strip()
+    if not token or not _is_oauth_token(token):
+        return None  # an API key pays per token and has no subscription window to ask about
+    key = hashlib.sha256(f"{token}\0{model or ''}".encode()).hexdigest()
+    now = time.monotonic()
+    with _lock:
+        cached = _cache.get(key)
+        if cached is not None and (now - cached[0]) < min_interval_seconds:
+            return cached[1]
+        _cache[key] = (now, None)  # reserve the slot so concurrent selectors don't stampede
+    result: Optional[bool] = None
+    try:
+        headers = {"Authorization": f"Bearer {token}", "Accept": "application/json",
+                   "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-code/2.1.0"}
+        with httpx.Client(timeout=10.0) as client:
+            response = client.get(ANTHROPIC_USAGE_URL, headers=headers)
+        if response.status_code == 200:
+            result = quota_restored(response.json() or {}, model)
+        elif response.status_code == 429:
+            result = False
+    except (httpx.HTTPError, OSError, ValueError):  # no answer, or a body that is not JSON: fail closed
+        logger.debug("Anthropic quota probe failed", exc_info=True)
+        result = None
+    with _lock:
+        _cache[key] = (now, result)
+    if result:
+        logger.info("Anthropic usage says the Claude subscription limit for %s reopened before its declared reset",
+                    model or "this login")
+    return result
