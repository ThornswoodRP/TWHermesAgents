diff --git a/tests/agent/test_anthropic_quota_early_reopen.py b/tests/agent/test_anthropic_quota_early_reopen.py
new file mode 100644
index 00000000..57086b04
--- /dev/null
+++ b/tests/agent/test_anthropic_quota_early_reopen.py
@@ -0,0 +1,208 @@
+"""A Claude subscription limit that reopens before its declared reset lifts the login's model bench.
+
+An Anthropic 429 benches the OAuth login for the refused model until the reset the response named
+(days out for the weekly window). When the account is given a reset early, only Anthropic's usage
+endpoint says so; the pool asks it (throttled, fails closed) on the lifting paths, and a session pinned
+to its fallback asks through ``_primary_quota_reopened_early``.
+
+Real ``agent.credential_pool`` against a real temp auth store; the usage endpoint is stubbed.
+"""
+import json
+import time
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+TOKEN = "sk-ant-oat01-test"
+MODEL = "claude-opus-4-6"
+OTHER = "claude-sonnet-4-5"
+WEEK = 3 * 86400
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    root = tmp_path / "hermes-root"
+    root.mkdir()
+    (tmp_path / "fakehome").mkdir()
+    monkeypatch.setenv("HOME", str(tmp_path / "fakehome"))
+    monkeypatch.setenv("CLAUDE_CONFIG_DIR", str(tmp_path / "fakehome"))
+    for var in ("ANTHROPIC_TOKEN", "ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    import hermes_constants
+    hermes_constants._default_hermes_root_memo = None  # type: ignore[attr-defined]
+    from agent import anthropic_quota_probe
+    anthropic_quota_probe._cache.clear()
+    return root
+
+
+def _write_benched(root, until_in=WEEK, cooldowns=None):
+    until = time.time() + until_in
+    (root / "auth.json").write_text(json.dumps({"credential_pool": {"anthropic": [{
+        "id": "max", "label": "max", "auth_type": "oauth", "priority": 0, "source": "manual",
+        "access_token": TOKEN, "refresh_token": "refresh",
+        # Not due for a refresh: the probe asks with the stored token.
+        "expires_at_ms": int((time.time() + 3600) * 1000),
+        "model_cooldowns": cooldowns if cooldowns is not None else {MODEL: until},
+    }]}}))
+
+
+def _pool():
+    from agent.credential_pool import load_pool
+    return load_pool("anthropic")
+
+
+def _stored_cooldowns(root):
+    rows = json.loads((root / "auth.json").read_text())["credential_pool"]["anthropic"]
+    return rows[0].get("model_cooldowns") or {}
+
+
+def test_a_reopened_window_lifts_the_model_bench_and_it_stays_lifted(home):
+    _write_benched(home, cooldowns={MODEL: time.time() + WEEK, OTHER: time.time() + WEEK})
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=True) as probe:
+        assert pool.lift_reopened_cooldowns(model=MODEL) is True
+    probe.assert_called_once_with(TOKEN, model=MODEL)
+    assert pool.next_available_at(model=MODEL) is None
+    # Only the model it asked about: the other model's bench is its own observation.
+    assert pool.next_available_at(model=OTHER) is not None
+    # Persisted as a reset, so the disk's older cooldown is not merged back, and another process agrees.
+    assert MODEL not in _stored_cooldowns(home) and OTHER in _stored_cooldowns(home)
+    assert _pool().select(model=MODEL) is not None
+
+
+def test_a_full_window_keeps_the_bench(home):
+    _write_benched(home)
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=False):
+        assert pool.lift_reopened_cooldowns(model=MODEL) is False
+    assert pool.next_available_at(model=MODEL) is not None
+    assert MODEL in _stored_cooldowns(home)
+
+
+def test_no_answer_keeps_the_bench(home):
+    _write_benched(home)
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=None):
+        assert pool.lift_reopened_cooldowns(model=MODEL) is False
+    assert pool.next_available_at(model=MODEL) is not None
+
+
+def test_a_short_bench_is_not_asked_about(home):
+    """A per-minute limit lifts by itself before the probe interval would let it ask again."""
+    _write_benched(home, until_in=60)
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=True) as probe:
+        assert pool.lift_reopened_cooldowns(model=MODEL) is False
+    probe.assert_not_called()
+
+
+def test_read_only_paths_never_probe(home):
+    _write_benched(home)
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=True) as probe:
+        assert pool.has_available(model=MODEL) is False
+        assert pool.next_available_at(model=MODEL) is not None
+    probe.assert_not_called()
+
+
+def test_an_api_key_is_never_asked_about(home):
+    (home / "auth.json").write_text(json.dumps({"credential_pool": {"anthropic": [{
+        "id": "seat", "label": "seat", "auth_type": "api_key", "priority": 0, "source": "manual",
+        "access_token": "sk-ant-api03-test",
+        "model_cooldowns": {MODEL: time.time() + WEEK},
+    }]}}))
+    pool = _pool()
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=True) as probe:
+        assert pool.lift_reopened_cooldowns(model=MODEL) is False
+    probe.assert_not_called()
+
+
+@pytest.mark.parametrize("payload, model, want", [
+    ({"five_hour": {"utilization": 12.0}, "seven_day": {"utilization": 40.0}}, MODEL, True),
+    ({"five_hour": {"utilization": 12.0}, "seven_day": {"utilization": 100.0}}, MODEL, False),
+    ({"five_hour": {"utilization": 100}, "seven_day": {"utilization": 3.0}}, MODEL, False),
+    # The Opus week caps Opus only.
+    ({"five_hour": {"utilization": 5.0}, "seven_day": {"utilization": 5.0},
+      "seven_day_opus": {"utilization": 100.0}}, MODEL, False),
+    ({"five_hour": {"utilization": 5.0}, "seven_day": {"utilization": 5.0},
+      "seven_day_opus": {"utilization": 100.0}}, OTHER, True),
+    # Read as /usage reads it: a value at or under 1 is a fraction.
+    ({"five_hour": {"utilization": 0.25}, "seven_day": {"utilization": 0.5}}, MODEL, True),
+    ({}, MODEL, None),
+    ({"five_hour": None, "seven_day": {"utilization": "x"}}, MODEL, None),
+])
+def test_usage_windows_read(payload, model, want):
+    from agent.anthropic_quota_probe import quota_restored
+    assert quota_restored(payload, model) is want
+
+
+def test_probe_asks_once_per_interval_and_fails_closed(home):
+    from agent import anthropic_quota_probe as probe_mod
+
+    calls = []
+
+    class Response:
+        status_code = 200
+
+        @staticmethod
+        def json():
+            return {"five_hour": {"utilization": 3.0}, "seven_day": {"utilization": 10.0}}
+
+    class Client:
+        def __init__(self, *a, **k):
+            pass
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+        def get(self, url, headers):
+            calls.append((url, headers.get("Authorization")))
+            return Response()
+
+    with patch.object(probe_mod.httpx, "Client", Client):
+        assert probe_mod.probe_anthropic_quota_restored(TOKEN, model=MODEL) is True
+        assert probe_mod.probe_anthropic_quota_restored(TOKEN, model=MODEL) is True
+    assert calls == [(probe_mod.ANTHROPIC_USAGE_URL, f"Bearer {TOKEN}")]
+
+    probe_mod._cache.clear()
+
+    class Refused(Client):
+        def get(self, url, headers):
+            raise OSError("no route")
+
+    with patch.object(probe_mod.httpx, "Client", Refused):
+        assert probe_mod.probe_anthropic_quota_restored(TOKEN, model=MODEL) is None
+    assert probe_mod.probe_anthropic_quota_restored("sk-ant-api03-key", model=MODEL) is None
+
+
+def test_a_session_pinned_to_its_fallback_asks_and_clears_its_own_cooldown(home):
+    """``_primary_quota_reopened_early`` now asks for an Anthropic primary, as it does for Codex."""
+    from agent.agent_runtime_helpers import _primary_quota_reopened_early
+
+    _write_benched(home)
+    agent = MagicMock(spec=[])
+    agent._credential_pool = None
+
+    def load():
+        return _pool()
+
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=True):
+        assert _primary_quota_reopened_early(agent, "anthropic", MODEL, lambda p: True, load) is True
+        # Throttled per agent: a second ask inside the interval does not load the pool again.
+        assert _primary_quota_reopened_early(agent, "anthropic", MODEL, lambda p: True, load) is False
+    assert MODEL not in _stored_cooldowns(home)
+
+
+def test_a_session_whose_window_is_still_full_stays_put(home):
+    from agent.agent_runtime_helpers import _primary_quota_reopened_early
+
+    _write_benched(home)
+    agent = MagicMock(spec=[])
+    agent._credential_pool = None
+    with patch("agent.anthropic_quota_probe.probe_anthropic_quota_restored", return_value=False):
+        assert _primary_quota_reopened_early(agent, "anthropic", MODEL, lambda p: True, _pool) is False
+    assert MODEL in _stored_cooldowns(home)
