--- /dev/null
+++ b/apps/desktop/electron/cron-job-union.test.ts
@@ -0,0 +1,145 @@
+/**
+ * Tests for electron/cron-job-union.ts: the Scheduled jobs list across every
+ * connected gateway, each job tagged with the connection that serves it.
+ *
+ * Run with: npx vitest run electron/cron-job-union.test.ts
+ */
+
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { type CronUnionSource, isAllProfilesCronListRequest, mergeRegistryCronJobs, otherCronSources } from './cron-job-union'
+
+const source = (connectionId: string, backendId?: string, descriptors = [connectionId]): CronUnionSource => ({
+  backendId,
+  backends: descriptors.map(descriptor => ({ descriptor })),
+  connectionId
+})
+
+function jsonFrom(answers: Record<string, unknown>) {
+  const calls: Array<{ descriptor: unknown; path: string }> = []
+
+  const getJson = async (descriptor: unknown, path: string) => {
+    calls.push({ descriptor, path })
+    const answer = answers[String(descriptor)]
+
+    if (answer instanceof Error) {
+      throw answer
+    }
+
+    return answer
+  }
+
+  return { calls, getJson }
+}
+
+test('only a GET of the cross-profile list is the unified list', () => {
+  assert.equal(isAllProfilesCronListRequest('GET', '/api/cron/jobs'), true)
+  assert.equal(isAllProfilesCronListRequest(undefined, '/api/cron/jobs?profile=all'), true)
+  assert.equal(isAllProfilesCronListRequest('get', '/api/cron/jobs/?profile=ALL'), true)
+  assert.equal(isAllProfilesCronListRequest('GET', '/api/cron/jobs?profile=bramble'), false)
+  assert.equal(isAllProfilesCronListRequest('POST', '/api/cron/jobs'), false)
+  assert.equal(isAllProfilesCronListRequest('GET', '/api/cron/jobs/abc'), false)
+  assert.equal(isAllProfilesCronListRequest('GET', '/api/cron/jobs/abc/runs'), false)
+  assert.equal(isAllProfilesCronListRequest('GET', undefined), false)
+})
+
+test("another gateway's jobs join the front's, tagged with their connection", async () => {
+  const front = [{ id: 'mine', profile: 'default' }]
+
+  const { calls, getJson } = jsonFrom({
+    'thornswood-bots': [
+      { id: 'review-1', profile: 'bramble' },
+      { id: 'review-2', profile: 'bramble' }
+    ]
+  })
+
+  const merged = await mergeRegistryCronJobs(front, [source('thornswood-bots', 'b')], getJson, {
+    backendId: 'a',
+    connectionId: null
+  })
+
+  assert.deepEqual(merged, [
+    { id: 'mine', profile: 'default' },
+    { connection_id: 'thornswood-bots', id: 'review-1', profile: 'bramble' },
+    { connection_id: 'thornswood-bots', id: 'review-2', profile: 'bramble' }
+  ])
+  assert.deepEqual(calls, [{ descriptor: 'thornswood-bots', path: '/api/cron/jobs?profile=all' }])
+})
+
+test('the front connection and backends already listed are not read again', () => {
+  const sources = [
+    source('my-hermes', 'vm-1'),
+    source('thornswood-bots', 'vm-2'),
+    source('same-gateway-again', 'vm-2'),
+    source('local', 'one'),
+    source('no-install-id')
+  ]
+
+  assert.deepEqual(
+    otherCronSources(sources, { backendId: 'one', connectionId: 'my-hermes' }).map(s => s.connectionId),
+    ['thornswood-bots', 'no-install-id']
+  )
+  assert.deepEqual(
+    otherCronSources(sources, { backendId: null, connectionId: null }).map(s => s.connectionId),
+    ['my-hermes', 'thornswood-bots', 'local', 'no-install-id']
+  )
+})
+
+test('with no other gateway the front answer is returned as it is', async () => {
+  const front = [{ id: 'mine' }]
+  const { calls, getJson } = jsonFrom({})
+
+  assert.equal(await mergeRegistryCronJobs(front, [], getJson, { connectionId: null }), front)
+  assert.equal(await mergeRegistryCronJobs(front, [source('local')], getJson, { connectionId: 'local' }), front)
+  assert.equal(calls.length, 0)
+})
+
+test("an error body from the front is never hidden behind other gateways' jobs", async () => {
+  const failure = { detail: 'boom' }
+  const { calls, getJson } = jsonFrom({ other: [{ id: 'x' }] })
+
+  assert.equal(await mergeRegistryCronJobs(failure, [source('other')], getJson, { connectionId: null }), failure)
+  assert.equal(calls.length, 0)
+})
+
+test("a dead backend falls to the source's next one, and a dead source adds nothing", async () => {
+  const { getJson } = jsonFrom({
+    'bots-a': new Error('ECONNREFUSED'),
+    'bots-b': [{ id: 'review', profile: 'bramble' }],
+    gone: new Error('timeout')
+  })
+
+  const merged = await mergeRegistryCronJobs(
+    [],
+    [source('thornswood-bots', undefined, ['bots-a', 'bots-b']), source('gone')],
+    getJson,
+    { connectionId: null }
+  )
+
+  assert.deepEqual(merged, [{ connection_id: 'thornswood-bots', id: 'review', profile: 'bramble' }])
+})
+
+test('each job is listed once per (connection, profile, id); "unknown" ids are never merged', async () => {
+  const { getJson } = jsonFrom({
+    bots: [
+      { id: 'review', profile: 'bramble' },
+      { id: 'review', profile: 'bramble' },
+      { id: 'review', profile: 'rift' },
+      { id: 'unknown' },
+      { id: 'unknown' },
+      null,
+      'junk'
+    ]
+  })
+
+  const merged = (await mergeRegistryCronJobs([], [source('bots')], getJson, { connectionId: null })) as unknown[]
+
+  assert.deepEqual(merged, [
+    { connection_id: 'bots', id: 'review', profile: 'bramble' },
+    { connection_id: 'bots', id: 'review', profile: 'rift' },
+    { connection_id: 'bots', id: 'unknown' },
+    { connection_id: 'bots', id: 'unknown' }
+  ])
+})
diff --git a/apps/desktop/electron/cron-job-union.ts b/apps/desktop/electron/cron-job-union.ts
new file mode 100644
index 0000000000..5e2fc76fd2
--- /dev/null
+++ b/apps/desktop/electron/cron-job-union.ts
@@ -0,0 +1,169 @@
+/**
+ * The unified Scheduled jobs list: the jobs of the connection in front plus
+ * every CONNECTED registry gateway's jobs, the way the unified Sessions list
+ * already splices every connected gateway's chats in (#88880).
+ *
+ * Cron jobs live in each backend's own profile tree. The renderer's list call
+ * names only the connection in front, so a job on another registered
+ * connection (a Bot's schedule on an SSH host while you read a chat on This
+ * device) never reached the sidebar's Cron jobs section or the Scheduled jobs
+ * page. Every job read here is tagged with the `connection_id` that serves it,
+ * so its per-job calls (pause, trigger, edit, runs) go to that backend.
+ *
+ * Only already-pooled backends are read (the caller passes the same sources
+ * the Sessions list uses): a list refresh must never dial or spawn a backend.
+ * A dead or erroring gateway contributes nothing rather than breaking the list.
+ */
+
+type GetJson = (descriptor: unknown, path: string) => Promise<unknown>
+
+export interface CronUnionSource {
+  backends: Array<{ descriptor: unknown }>
+  connectionId: string
+  /** The gateway's install_id, when known. Two sources with one install_id are
+   *  one backend (one profile tree), so its jobs are listed once. */
+  backendId?: string
+}
+
+/** The connection in front: its registry id (null for the unpinned primary)
+ *  and its gateway install_id when known. */
+export interface CronUnionFront {
+  backendId?: null | string
+  connectionId: null | string
+}
+
+const ALL_PROFILES_CRON_PATH = '/api/cron/jobs?profile=all'
+
+/** A GET of the cross-profile job list: `/api/cron/jobs` with no profile or `profile=all`. */
+export function isAllProfilesCronListRequest(method: string | undefined, path: string | undefined): boolean {
+  if ((method || 'GET').toUpperCase() !== 'GET' || typeof path !== 'string') {
+    return false
+  }
+
+  let url: URL
+
+  try {
+    url = new URL(path, 'http://x')
+  } catch {
+    return false
+  }
+
+  if (url.pathname.replace(/\/+$/, '') !== '/api/cron/jobs') {
+    return false
+  }
+
+  return (url.searchParams.get('profile') || 'all').trim().toLowerCase() === 'all'
+}
+
+function jobIdentity(connectionId: string, job: Record<string, unknown>): null | string {
+  const id = String(job.id ?? job.job_id ?? '').trim()
+
+  // cron.jobs fills a missing id with the sentinel "unknown"; never merge on it.
+  if (!id || id === 'unknown') {
+    return null
+  }
+
+  return `${connectionId}\u0000${String(job.profile ?? '').trim() || 'default'}\u0000${id}`
+}
+
+/** One source's jobs from the first of its backends that answers. Every
+ *  backend of a connection serves the same profile tree (an SSH source runs one
+ *  backend per profile over one HERMES_HOME), so one answer covers it. */
+async function readSourceJobs(source: CronUnionSource, getJson: GetJson): Promise<Record<string, unknown>[]> {
+  for (const { descriptor } of source.backends) {
+    try {
+      const jobs = await getJson(descriptor, ALL_PROFILES_CRON_PATH)
+
+      if (Array.isArray(jobs)) {
+        return jobs.filter((job): job is Record<string, unknown> => Boolean(job) && typeof job === 'object')
+      }
+    } catch {
+      // Dead or still-starting backend: try the source's next backend.
+    }
+  }
+
+  return []
+}
+
+const trimmed = (value: unknown): string => (typeof value === 'string' ? value.trim() : '')
+
+/** The sources that are another backend than the front and than each other:
+ *  a source is skipped when it IS the front connection, or when its install_id
+ *  is the front's or an earlier source's (the same gateway registered twice,
+ *  or the unpinned primary that is also a registry connection). */
+export function otherCronSources(sources: readonly CronUnionSource[], front: CronUnionFront): CronUnionSource[] {
+  const frontConnection = trimmed(front.connectionId)
+  const seenBackends = new Set<string>()
+  const frontBackend = trimmed(front.backendId)
+
+  if (frontBackend) {
+    seenBackends.add(frontBackend)
+  }
+
+  const others: CronUnionSource[] = []
+
+  for (const source of sources) {
+    if (!source.connectionId || source.connectionId === frontConnection) {
+      continue
+    }
+
+    const backendId = trimmed(source.backendId)
+
+    if (backendId) {
+      if (seenBackends.has(backendId)) {
+        continue
+      }
+
+      seenBackends.add(backendId)
+    }
+
+    others.push(source)
+  }
+
+  return others
+}
+
+/**
+ * `base` is the front connection's own answer and is returned first and
+ * untagged (its rows already belong to the connection the renderer named).
+ * A non-array `base` (an error body) is returned unchanged: the union never
+ * hides the front connection's failure.
+ */
+export async function mergeRegistryCronJobs(
+  base: unknown,
+  sources: readonly CronUnionSource[],
+  getJson: GetJson,
+  front: CronUnionFront
+): Promise<unknown> {
+  if (!Array.isArray(base)) {
+    return base
+  }
+
+  const others = otherCronSources(sources, front)
+
+  if (others.length === 0) {
+    return base
+  }
+
+  const merged: unknown[] = [...base]
+  const seen = new Set<string>()
+  const reads = await Promise.all(others.map(source => readSourceJobs(source, getJson)))
+
+  others.forEach((source, index) => {
+    for (const job of reads[index]) {
+      const identity = jobIdentity(source.connectionId, job)
+
+      if (identity) {
+        if (seen.has(identity)) {
+          continue
+        }
+
+        seen.add(identity)
+      }
+
+      merged.push({ ...job, connection_id: source.connectionId })
+    }
+  })
+
+  return merged
+}
