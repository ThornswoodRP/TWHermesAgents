#!/usr/bin/python3 -I
# Starts one broker from the root-owned copy. -I: no user site, no PYTHONPATH,
# no current folder on the path, so only this copy's code is imported.
import sys
from pathlib import Path
# The release this file is in: /opt/thornswood-hermes/bin links here through current.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
from thornswood_brokers.serve import main  # noqa: E402
main(sys.argv[1:])
