# GitHub's lists change, so they are read again each day (a new range is
# blocked until then, which fails closed).
[Unit]
Description=Thornswood-Hermes: read what tw-runner may reach again

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
Unit=tw-runner-egress-refresh.service

[Install]
WantedBy=timers.target
