# tw-files's socket, held by systemd (#162). A broker that starts again for
# an install takes the same socket back, so no call is refused while it is
# away: the calls wait here and it answers them when it is up. 12 Nov 2026:
# each restart removed the broker's own socket for a second or two, and a
# turn whose ticket check was refused then was refused for the rest of it.
# The path and the group are the policy's (brokers.sockets.files).
[Unit]
Description=Thornswood tw-files socket

[Socket]
ListenStream=/run/tw-brokers/files.sock
SocketUser=tw-files
SocketGroup=tw-files-clients
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
