# The daily read of tw-runner's table (tw-runner-egress.timer). A oneshot of its own,
# because tw-runner-egress.service stays active once it has run.
[Unit]
Description=Thornswood-Hermes: read what tw-runner may reach again
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/thornswood-hermes/bin/tw-runner-egress
TimeoutStartSec=5min
