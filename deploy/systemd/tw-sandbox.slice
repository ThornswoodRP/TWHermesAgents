# every Tier B check, as tw-<bot>.
# Generated from thornswood_guard/policy.yaml by scripts/render_units.py; do not edit by hand.
# A limit changes only by a PR to the policy, never on the box.
[Unit]
Description=Thornswood: every Tier B check, as tw-<bot>
Before=slices.target

[Slice]
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryHigh=3584M
MemoryMax=4G
CPUWeight=50
CPUQuota=100%
TasksMax=1024
