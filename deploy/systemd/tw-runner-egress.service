# What the guard rail tests' runner may reach: GitHub and the package feeds,
# on port 443, and nothing else (thornswood_brokers/runner_egress.py). Root,
# because the table is the kernel's.
[Unit]
Description=Thornswood-Hermes: what tw-runner may reach
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/thornswood-hermes/bin/tw-runner-egress
TimeoutStartSec=5min
