# tw-git: the only GitHub writer, with the two Apps' keys (08 section 4).
[Unit]
Description=Thornswood tw-git
After=tw-policy.socket tw-git.socket network-online.target
Wants=network-online.target tw-policy.socket
Requires=tw-git.socket
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=simple
User=tw-git
Group=tw-git
SupplementaryGroups=tw-policy-clients tw-git-clients tw-spool tw-decide-git
Slice=tw-brokers.slice
ExecStart=/opt/thornswood-hermes/bin/tw-serve git
ReadWritePaths=/srv/tw/git /srv/tw/spool/in
ReadOnlyPaths=/srv/tw/spool/out /etc/thornswood/apps
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0007
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
