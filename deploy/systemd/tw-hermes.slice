# the gateway (six profiles and the room) and hermes serve, as hermes.
# Generated from src/thornswood_guard/policy.yaml by scripts/render_units.py; do not edit by hand.
# A limit changes only by a PR to the policy, never on the box.
[Unit]
Description=Thornswood: the gateway (six profiles and the room) and hermes serve, as hermes
Before=slices.target

[Slice]
