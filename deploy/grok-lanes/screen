#!/usr/bin/env bash
# The Grok lanes' screen (tw-grok-screen.service): the app's virtual screen
# in a browser, for Patrick's sign-in, and the sign-in link open-url wrote.
# x11vnc shows display :<display> on a Unix socket in this account's own
# folder, never a port; websockify serves noVNC and that socket on the VM's
# Tailscale address alone, so only Patrick's tailnet reaches it. The unit
# stops by itself after its RuntimeMaxSec.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)"
display="${1:?usage: screen <display> <port>}"
port="${2:?usage: screen <display> <port>}"
[[ "$display" =~ ^[0-9]+$ && "$port" =~ ^[0-9]+$ ]] || { echo "the display and the port are numbers"; exit 2; }
ts="$(tailscale ip -4 2>/dev/null | head -1)"
[[ "$ts" =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "this VM has no Tailscale address, so the screen is not served anywhere"; exit 2; }
web="$HOME/web"
sock="$HOME/run/vnc.sock"
install -d -m 0700 "$HOME/run"
install -d -m 0755 "$web"
ln -sfnT /usr/share/novnc "$web/novnc"
install -m 0644 "$here/index.html" "$web/index.html"
rm -f "$sock"
export XAUTHORITY="$HOME/.Xauthority"
x11vnc -display ":$display" -rfbport 0 -unixsock "$sock" -forever -shared -nopw -quiet &
vnc=$!
trap 'kill "$vnc" 2>/dev/null || true' EXIT
for _ in $(seq 1 50); do [[ -S "$sock" ]] && break; sleep 0.2; done
[[ -S "$sock" ]] || { echo "x11vnc did not make its socket; is tw-grok-lanes.service running?"; exit 1; }
websockify --web "$web" --unix-target "$sock" "$ts:$port"
