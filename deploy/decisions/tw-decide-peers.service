# tw-decide-peers: the tailnet's own view of the machine each own-Hermes
# connector posts from (One), from the VM's Tailscale client, read only. The
# core keeps only Online and LastSeen, so the phone says "One is off" only when
# Tailscale says so, never because the connector went quiet (plan Part 1).
[Unit]
Description=Thornswood decision core: is One on, as the tailnet sees it
After=tw-decide.service tailscaled.service

[Service]
Type=oneshot
User=tw-decide
Group=tw-decide
ExecStart=/opt/thornswood-hermes/bin/tw-decide --db /srv/tw/decide/core.db peers --workspace thornswood
ReadWritePaths=/srv/tw/decide
# The Tailscale client talks to tailscaled over its Unix socket only.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
MemoryMax=100M
TimeoutStartSec=60
