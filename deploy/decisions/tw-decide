#!/opt/thornswood-hermes/decisions-venv/bin/python3 -I
# Runs the decision core's commands from the root-owned copy, with the core's own venv (its passkey library). -I:
# no user site, no PYTHONPATH, no current folder on the path, so only this copy's code is imported.
import sys
from pathlib import Path
# The release this file is in: /opt/thornswood-hermes/bin links here through current.
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
from thornswood_decisions.cli import main  # noqa: E402
sys.exit(main(sys.argv[1:]))
