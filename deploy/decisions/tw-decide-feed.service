# tw-decide-feed: reads the Bots' Kanban and the Workbench room read-only, as
# the hermes user, and sends the decision core one snapshot of each (step 3).
[Unit]
Description=Thornswood decision core feeds (Work and Room)
After=tw-decide.service

[Service]
Type=oneshot
User=hermes
EnvironmentFile=/etc/thornswood/tw-decide.env
ExecStart=/opt/thornswood-hermes/bin/tw-decide-feed --room ${TW_DECIDE_ROOM}
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=100M
TimeoutStartSec=60
