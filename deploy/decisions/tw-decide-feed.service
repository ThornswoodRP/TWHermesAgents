# tw-decide-feed: reads the Workbench room and the Bot Chats read-only, as the
# hermes user, and sends the decision core one snapshot of each (step 3). The
# Board is tw-decide-live's.
[Unit]
Description=Thornswood decision core feeds (Room and Bot Chats)
After=tw-decide.service

[Service]
Type=oneshot
User=hermes
EnvironmentFile=/etc/thornswood/tw-decide.env
ExecStart=/opt/thornswood-hermes/bin/tw-decide-feed --room ${TW_DECIDE_ROOM}
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=100M
TimeoutStartSec=60
