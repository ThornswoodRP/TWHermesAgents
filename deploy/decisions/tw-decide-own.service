# tw-decide-own: carries Patrick's chat from the phone into his own Hermes on
# the VM, my-hermes. It runs as patrick-hermes, the user that Hermes runs as, and
# never as the Bots' hermes user: the Bots never see these messages, and this
# never reaches their Hermes. It does nothing, and copies nothing of his chats,
# while own_chat_write is off.
#
# Not ProtectSystem=strict and not PrivateTmp, for the same reason as the Bots'
# connector: the `hermes` command it runs writes to ~/.hermes and finds the
# gateway's control socket that Hermes made. install.sh adds XDG_RUNTIME_DIR and
# TW_OWN_HERMES_BIN in a drop-in.
[Unit]
Description=Thornswood decision core: chat from the phone into my-hermes
After=tw-decide.service

[Service]
Type=simple
User=patrick-hermes
ExecStart=/opt/thornswood-hermes/bin/tw-decide-own --gateway me --hermes ${TW_OWN_HERMES_BIN}
WorkingDirectory=~
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
ProtectSystem=full
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=900M
Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=15min
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
